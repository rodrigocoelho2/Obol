@model LandingModel
@{
    ViewData["Title"] = "Obol";
    var primaryHref = Model.SignedIn ? "/" : Model.CanCreateAccount ? "/create-account" : "/sign-in";
    var primaryText = Model.SignedIn ? "Open Obol" : Model.CanCreateAccount ? "Mint your account" : "Sign in";
    var secondaryHref = Model.SignedIn ? "/insights" : "/sign-in";
    var secondaryText = Model.SignedIn ? "See your insights" : "I have an account";
    var tape = new (string Symbol, string Name, string Move, bool Up)[]
    {
        ("IWDA", "MSCI World", "0.84%", true), ("VHYL", "All-World Dividend", "0.41%", true), ("NVDA", "NVIDIA", "2.13%", true),
        ("AAPL", "Apple", "0.62%", false), ("GALP", "Galp Energia", "1.20%", true), ("IEGA", "€ Govt Bond", "0.08%", true),
        ("SXR8", "S&P 500", "0.57%", true), ("EUR/USD", "Euro", "0.21%", false), ("O", "Realty Income", "0.35%", true), ("MSFT", "Microsoft", "0.94%", true),
    };
}
@section Head {
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
}

<div class="lp" data-landing>
    <header class="lp-top">
        <a class="brand" href="/">@Icons.Logo(34)Obol</a>
        <nav class="row">
            @if (Model.SignedIn)
            {
                <a class="btn small" href="/">Open Obol @Icons.Get("arrow")</a>
            }
            else
            {
                <a class="btn ghost small" href="/sign-in">Sign in</a>
                @if (Model.CanCreateAccount)
                {
                    <a class="btn small desk-only" href="/create-account">Get started</a>
                }
            }
        </nav>
    </header>

    <section class="mint">
        <div class="mint-glow" aria-hidden="true"></div>
        <div class="mint-grid" aria-hidden="true"></div>

        <div class="mint-copy">
            <span class="mint-badge reveal" style="--d: 0"><span class="pulse"></span>Self-hosted · read-only · Trading 212</span>
            <h1 class="mint-title" aria-label="Every coin of your portfolio, minted into one view.">
                <span class="w" style="--d: 1">Every</span> <span class="w" style="--d: 2">coin</span> <span class="w" style="--d: 3">of</span> <span class="w" style="--d: 4">your</span>
                <span class="w" style="--d: 5">portfolio,</span> <span class="w shine" style="--d: 6">minted</span> <span class="w shine" style="--d: 7">into</span>
                <span class="w shine" style="--d: 8">one</span> <span class="w shine" style="--d: 9">view.</span>
            </h1>
            <p class="mint-lead reveal" style="--d: 10">Obol follows your Trading 212 account from your own server: what it's worth every day, each holding against what you paid, the dividends on their way, and whether you're actually beating the market.</p>
            <div class="row wrap reveal" style="--d: 11">
                <a class="btn big-btn" href="@primaryHref">@primaryText @Icons.Get("arrow")</a>
                <a class="btn ghost big-btn" href="@secondaryHref">@secondaryText</a>
            </div>
            <ul class="mint-proof reveal" style="--d: 12">
                <li>@Icons.Get("insights")<span><b>XIRR &amp; TWR</b> against MSCI World</span></li>
                <li>@Icons.Get("income")<span><b>Dividends</b> a year ahead</span></li>
                <li>@Icons.Get("sparkle")<span><b>AI coach</b> that reads it all</span></li>
            </ul>
        </div>

        <div class="mint-stage" aria-hidden="true" data-stage>
            <div class="halo"></div>
            <div class="coin-tilt" data-tilt>
                <div class="coin">
                    <div class="face front">
                        <svg viewBox="0 0 200 200">
                            <defs>
                                <radialGradient id="metal" cx="38%" cy="32%" r="75%">
                                    <stop offset="0" stop-color="#ECFFB8" />
                                    <stop offset="0.45" stop-color="#C6F36D" />
                                    <stop offset="1" stop-color="#8DB84A" />
                                </radialGradient>
                                <path id="legend" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
                            </defs>
                            <circle cx="100" cy="100" r="99" fill="url(#metal)" />
                            <circle cx="100" cy="100" r="93" fill="none" stroke="#0B0F0E" stroke-opacity="0.55" stroke-width="1.6" />
                            <circle cx="100" cy="100" r="66" fill="none" stroke="#0B0F0E" stroke-opacity="0.35" stroke-width="1" stroke-dasharray="2 4" />
                            <text font-family="Geist, sans-serif" font-size="11.5" font-weight="700" letter-spacing="3.2" fill="#0B0F0E" fill-opacity="0.72">
                                <textPath href="#legend">OBOL · EVERY COIN, ONE VIEW · SELF-HOSTED · TRADING 212 ·</textPath>
                            </text>
                            <circle cx="100" cy="100" r="44" fill="none" stroke="#0B0F0E" stroke-width="2.4" stroke-dasharray="3 4.4" />
                            <circle cx="100" cy="100" r="28" fill="none" stroke="#0B0F0E" stroke-width="5.4" />
                            <circle cx="100" cy="100" r="8.5" fill="#0B0F0E" />
                        </svg>
                    </div>
                    @for (var i = 0; i < 12; i++)
                    {
                        <div class="rim" style="--i: @i"></div>
                    }
                    <div class="face back">
                        <svg viewBox="0 0 200 200">
                            <defs>
                                <radialGradient id="metal-back" cx="60%" cy="30%" r="80%">
                                    <stop offset="0" stop-color="#E4FFA6" />
                                    <stop offset="0.5" stop-color="#BCEB60" />
                                    <stop offset="1" stop-color="#86B042" />
                                </radialGradient>
                            </defs>
                            <circle cx="100" cy="100" r="99" fill="url(#metal-back)" />
                            <circle cx="100" cy="100" r="93" fill="none" stroke="#0B0F0E" stroke-opacity="0.5" stroke-width="1.6" />
                            @* The owl of Athena, as on the obols of Athens: geometric. *@
                            <g fill="none" stroke="#0B0F0E" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.85">
                                <path d="M64 70 L74 52 L86 66 M136 70 L126 52 L114 66" />
                                <path d="M64 70 C60 110 66 146 100 158 C134 146 140 110 136 70 C124 62 76 62 64 70 Z" />
                                <circle cx="82" cy="90" r="13" />
                                <circle cx="118" cy="90" r="13" />
                                <path d="M100 100 L94 112 L100 120 L106 112 Z" />
                                <path d="M80 130 Q100 142 120 130 M84 142 Q100 152 116 142" stroke-width="3" />
                            </g>
                            <circle cx="82" cy="90" r="4.5" fill="#0B0F0E" />
                            <circle cx="118" cy="90" r="4.5" fill="#0B0F0E" />
                            <text x="150" y="132" font-family="Bricolage Grotesque, serif" font-size="17" font-weight="700" fill="#0B0F0E" fill-opacity="0.75">ΑΘΕ</text>
                            <path d="M150 52 q8 -10 14 2 q-8 4 -14 -2 Z" fill="#0B0F0E" fill-opacity="0.6" />
                        </svg>
                    </div>
                </div>
            </div>
            <div class="coin-shadow"></div>

            <div class="orbit o1"><div class="orb-y"><div class="orb-chip"><span class="asset-mini eq">IWDA</span><b class="up">▲ 0.84%</b></div></div></div>
            <div class="orbit o2"><div class="orb-y"><div class="orb-chip"><span class="asset-mini div">VHYL</span><span>dividend <b class="up">+€26.33</b></span></div></div></div>
            <div class="orbit o3"><div class="orb-y"><div class="orb-chip"><span class="asset-mini st">NVDA</span><b class="up">▲ 2.13%</b></div></div></div>

            <div class="worth-card">
                <div class="row" style="justify-content: space-between; align-items: center">
                    <span class="eyebrow">Net worth</span>
                    <span class="live"><i></i>live</span>
                </div>
                <div class="worth-num" data-count="14091.39">€14,091<span class="c">.39</span></div>
                <svg class="worth-chart" viewBox="0 0 300 80" preserveAspectRatio="none">
                    <defs><linearGradient id="worth-fade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#C6F36D" stop-opacity="0.28" /><stop offset="1" stop-color="#C6F36D" stop-opacity="0" /></linearGradient></defs>
                    <path class="area" d="M0,66 C22,62 32,70 46,60 S72,54 86,58 S112,46 126,48 S152,38 166,42 S192,30 206,34 S232,22 246,26 S272,14 286,17 L300,12 L300,80 L0,80 Z" fill="url(#worth-fade)" />
                    <path class="dep" d="M0,70 H48 V64 H96 V58 H144 V52 H192 V46 H240 V40 H300" pathLength="1" />
                    <path class="ln" d="M0,66 C22,62 32,70 46,60 S72,54 86,58 S112,46 126,48 S152,38 166,42 S192,30 206,34 S232,22 246,26 S272,14 286,17 L300,12" pathLength="1" />
                </svg>
                <div class="row wrap" style="gap: 6px">
                    <span class="pill solid">▲ €913 · 6.9% in 12 months</span>
                    <span class="pill soft vs">vs MSCI World <b>+€312</b></span>
                </div>
            </div>
        </div>
    </section>

    <div class="tape" aria-label="Today's moves">
        <div class="tape-track">
            @for (var round = 0; round < 2; round++)
            {
                foreach (var (symbol, name, move, up) in tape)
                {
                    <span class="tape-item" aria-hidden="@(round == 1 ? "true" : null)"><b class="mono">@symbol</b><span class="muted">@name</span><span class="@(up ? "up" : "down")">@(up ? "▲" : "▼") @move</span></span>
                }
            }
        </div>
    </div>

    <section class="feats">
        <article class="feat reveal-on" data-reveal>
            <div class="art art-sync">
                <span class="node t212">212</span>
                <svg class="wire" viewBox="0 0 200 40" preserveAspectRatio="none"><path d="M0,20 C60,20 60,20 100,20 S140,20 200,20" /></svg>
                <span class="packet p1"></span><span class="packet p2"></span><span class="packet p3"></span>
                <span class="node obol">@Icons.Logo(40)</span>
            </div>
            <h3>Trading 212, synced</h3>
            <p>A read-only key and Obol reads every order, dividend and deposit since day one, then keeps up every 30 minutes. No key? Drop the CSV export.</p>
        </article>
        <article class="feat reveal-on" data-reveal>
            <div class="art art-chart">
                <svg viewBox="0 0 220 90" preserveAspectRatio="none">
                    <path class="bench" d="M0,74 C30,70 50,66 80,60 S130,48 160,44 S200,34 220,30" pathLength="1" />
                    <path class="you" d="M0,78 C20,72 36,76 56,64 S92,58 110,50 S146,40 164,30 S200,22 220,12" pathLength="1" />
                </svg>
                <span class="tag you-tag">You +18.4%</span>
                <span class="tag bench-tag">MSCI World +14.1%</span>
            </div>
            <h3>Beat the index, or know it</h3>
            <p>Money-weighted and time-weighted returns, and what the same deposits would be worth in MSCI World or the S&amp;P 500, on the same days.</p>
        </article>
        <article class="feat reveal-on" data-reveal>
            <div class="art art-coins">
                <span class="stack-coin c1"></span><span class="stack-coin c2"></span><span class="stack-coin c3"></span><span class="stack-coin c4"></span>
                <span class="drop d1">@Icons.Logo(30)</span><span class="drop d2">@Icons.Logo(30)</span>
                <span class="float-amt">+€26.33</span>
            </div>
            <h3>Dividends, ahead of time</h3>
            <p>Every payment month by month, the next twelve worked out from your shares, raises and cuts per position, and the tax withheld abroad.</p>
        </article>
        <article class="feat reveal-on" data-reveal>
            <div class="art art-donut">
                <svg viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="42" class="trk" />
                    <circle cx="60" cy="60" r="42" class="seg s1" pathLength="100" />
                    <circle cx="60" cy="60" r="42" class="seg s2" pathLength="100" />
                    <circle cx="60" cy="60" r="42" class="seg s3" pathLength="100" />
                </svg>
                <div class="donut-legend"><span><i class="l1"></i>USD 62%</span><span><i class="l2"></i>EUR 33%</span><span><i class="l3"></i>GBP 5%</span></div>
            </div>
            <h3>Where your money really is</h3>
            <p>Currencies and what the exchange rate did, sectors, countries, how concentrated you are, and what each sale made, year by year.</p>
        </article>
    </section>

    <section class="nas reveal-on" data-reveal>
        <div class="nas-copy">
            <span class="ico-chip">@Icons.Get("shield")</span>
            <h2>On your server. <span class="lime">Read&#8209;only.</span></h2>
            <p>One <span class="mono">docker compose up</span> on your NAS: SQL Server, the engine and the app. Your key never leaves it, Obol can't place an order, and the phone app installs from the browser.</p>
        </div>
        <div class="term">
            <div class="term-bar"><i></i><i></i><i></i><span>obol — nas</span></div>
            <pre><span class="t l1"><b>$</b> git clone github.com/rodrigocoelho2/Obol &amp;&amp; cd Obol</span>
<span class="t l2"><b>$</b> docker compose up -d --build</span>
<span class="t l3 ok">✔ obol-sql         healthy</span>
<span class="t l4 ok">✔ obol-db-deploy   database up to date</span>
<span class="t l5 ok">✔ obol-website     http://nas:5095</span><span class="caret"></span></pre>
        </div>
    </section>

    <footer class="lp-foot">
        <span>@Icons.Logo(22) Obol @AppPageModel.CurrentVersion · self-hosted</span>
        <span class="muted">Not affiliated with Trading 212. Not financial advice.</span>
    </footer>
</div>

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true"></script>
}
