@model OverviewPageModel
@{
    Layout = "_App";
    ViewData["Title"] = "Overview";
    var data = Model.Data!;
    var currency = data.Currency;
    var logos = Model.Connection?.Logos == true;
    var series = data.Series;
    var chart = Charts.Line(
        series.Select(static point => point.Value).ToList(),
        series.Select(static point => Fmt.ShortDate(point.Day)).ToList(),
        series.Select(point => Fmt.Money(point.Value, currency)).ToList(),
        250,
        data.NetDeposits is null ? null : series.Select(static point => point.Deposits).ToList(),
        data.NetDeposits is null ? null : series.Select(point => "Deposited " + Fmt.Money(point.Deposits, currency, 0)).ToList());
    var axis = series.Count < 2 ? [] : Enumerable.Range(0, 6).Select(i => series[(int)Math.Round(i * (series.Count - 1) / 5.0)].Day).ToList();
    string AxisLabel(DateOnly day) => Model.Range is ChartRange.Week or ChartRange.Month ? Fmt.ShortDate(day) : day.ToString("MMM yy", System.Globalization.CultureInfo.GetCultureInfo("en-IE"));
    var down = data.RangeChange is < 0;
    // The Trading 212 view: every pie, and what is held outside them, biggest first.
    var hasPies = data.Pies.Count > 0;
    // This year's income as expected: received so far over the share of the year's payments received.
    decimal? incomeYear = data.IncomeProgress is > 0 ? data.IncomeThisYear / data.IncomeProgress.Value : null;
    // The ticker: every position that moved since the last close, biggest moves first.
    var ticker = data.Positions.Where(static position => position.DayChangePct is not null and not 0)
        .OrderByDescending(static position => Math.Abs(position.DayChangePct!.Value)).Take(12).ToList();
    var groups = data.Pies.Select(static pie => (Pie: (PieDTO?)pie, Slice: (PieHoldingDTO?)null, pie.Weight))
        .Concat(data.OutsidePies.Select(static slice => (Pie: (PieDTO?)null, Slice: (PieHoldingDTO?)slice, slice.Weight)))
        .OrderByDescending(static group => group.Weight)
        .ToList();
}

@* Phone: the greeting, and the sync button. *@
<header class="head phone-only">
    <div class="greet">
        <a href="/settings" aria-label="Settings">@Icons.Logo(40)</a>
        <div>
            <small>@Model.Greeting</small>
            <b>@Model.DisplayName</b>
        </div>
    </div>
    <a class="chip-live" href="/sync" aria-label="Sync: @Model.SyncLabel"><span class="dot @Model.SyncDot"></span>@(Model.SyncDot == "ok" ? "Live" : "Sync")</a>
</header>

@if (!data.HasData)
{
    <section class="card empty minted">
        @Icons.Rings()
        <div class="pad" style="display: flex; flex-direction: column; gap: 12px">
            <span class="ico-chip">@Icons.Get("link")</span>
            <h2>Bring your portfolio in</h2>
            <p>Connect Trading 212 with a read-only API key and Obol syncs your positions, every order, dividend and deposit, and keeps them up to date. Or import the CSV export from Trading 212's History.</p>
            <div class="row wrap">
                <a class="btn" href="/sync">@Icons.Get("link")Connect Trading 212</a>
                <a class="btn ghost" href="/sync#csv">@Icons.Get("upload")Import a CSV</a>
            </div>
        </div>
    </section>
}
else
{
    <section class="card minted" aria-labelledby="worth">
        @Icons.Rings()
        <div class="pad hero-top">
            <div>
                <div class="eyebrow" id="worth">Net worth<span class="desk-only"> · @Fmt.LongDate(Clock.Today)</span></div>
                <div class="big" style="margin-top: 8px">@Ui.BigMoney(data.TotalValue, currency)</div>
                <div class="hero-chips">
                    @if (data.DayChange != 0)
                    {
                        <span class="pill solid@(data.DayChange < 0 ? " loss" : string.Empty)">@(data.DayChange >= 0 ? "▲" : "▼") @Fmt.Money(Math.Abs(data.DayChange), currency) · @Fmt.Pct(data.DayChangePct is { } d ? Math.Abs(d) : null, 2) <span class="desk-only">&nbsp;today</span></span>
                    }
                    @if (data.RangeChange is { } change)
                    {
                        <span class="pill soft@(change < 0 ? " loss" : string.Empty)">@(change >= 0 ? "▲" : "▼") @Fmt.Money(Math.Abs(change), currency, 0)@(data.RangeChangePct is { } pct ? " · " + Fmt.Pct(Math.Abs(pct)) : string.Empty) <span>&nbsp;@Fmt.RangeWords(Model.Range)</span></span>
                    }
                    @if (data.VsWorld is { } vs)
                    {
                        <a class="pill violet desk-only" href="/insights?range=@Fmt.RangeQuery(Model.Range)">vs MSCI World @Fmt.SignedMoney(vs, currency, 0)</a>
                    }
                </div>
            </div>
            <nav class="seg desk-only" aria-label="Range">
                @foreach (var range in ScreenModel.Ranges)
                {
                    <a href="/?range=@Fmt.RangeQuery(range)" aria-current="@(range == Model.Range ? "page" : null)">@Fmt.Range(range)</a>
                }
            </nav>
        </div>

        @if (chart.HasLine)
        {
            ViewData["Height"] = 250;
            ViewData["PhoneHeight"] = 140;
            ViewData["Down"] = down;
            ViewData["Label"] = $"Portfolio value {Fmt.RangeWords(Model.Range)}, from {Fmt.Money(series[0].Value, currency)} to {Fmt.Money(series[^1].Value, currency)}";
            <partial name="_Chart" model="chart" view-data="ViewData" />
            <div class="axis desk-only">
                @foreach (var day in axis)
                {
                    <span>@AxisLabel(day)</span>
                }
            </div>
        }
        else
        {
            <p class="no-chart">The chart fills in after the first days of syncs.</p>
        }

        <nav class="seg full phone-only" aria-label="Range" style="margin: 10px 14px 0; width: auto">
            @foreach (var range in ScreenModel.Ranges)
            {
                <a href="/?range=@Fmt.RangeQuery(range)" aria-current="@(range == Model.Range ? "page" : null)">@Fmt.Range(range)</a>
            }
        </nav>

        <div class="pad desk-only">
            @if (data.NetDeposits is not null && chart.HasLine)
            {
                <div class="legend">
                    <span><i class="ln"></i>Value</span>
                    <span><i class="ln dash"></i>Net deposits</span>
                </div>
            }
            <div class="hero-tiles">
                <div><small>Put in</small><b>@(data.NetDeposits is { } put ? Fmt.Money(put, currency, 0) : "—")</b></div>
                <div><small>Total return</small><b class="@Fmt.Trend(data.TotalReturn)">@(data.TotalReturn is { } ret ? Fmt.SignedMoney(ret, currency) : "—")@if (data.TotalReturnPct is { } rp) {<span>&nbsp;@Fmt.Pct(Math.Abs(rp))</span>}</b></div>
                <div><small>Income @Clock.Today.Year</small><b>@Fmt.Money(data.IncomeThisYear, currency)@if (incomeYear is { } expectedYear) {<span class="muted">&nbsp;of @Fmt.Money(expectedYear, currency, 0)</span>}</b></div>
                <div><small>Cash</small><b>@Fmt.Money(data.Cash, currency)</b></div>
            </div>
        </div>
    </section>

    @if (ticker.Count > 0)
    {
        <div class="ticker" aria-label="Today, since the last close">
            <div class="ticker-track">
                @for (var lap = 0; lap < 2; lap++)
                {
                    <div class="ticker-lap" aria-hidden="@(lap == 1 ? "true" : null)">
                        @foreach (var position in ticker)
                        {
                            <a class="tick" href="@Ui.Href(position.Instrument)" tabindex="@(lap == 1 ? "-1" : null)"><b>@position.Instrument.Symbol</b><span class="ellipsis">@position.Instrument.Name</span><span class="@Fmt.Trend(position.DayChangePct)">@Fmt.Arrow(position.DayChangePct, 2)</span></a>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <section class="kpis phone-only">
        <div class="kpi"><small>Net deposits</small><b>@(data.NetDeposits is { } put2 ? Fmt.Money(put2, currency, 0) : "—")</b></div>
        <div class="kpi"><small>Total return</small><b class="@Fmt.Trend(data.TotalReturn)">@(data.TotalReturnPct is { } rp2 ? Fmt.SignedPct(rp2, 1) : data.TotalReturn is { } r2 ? Fmt.SignedMoney(r2, currency, 0) : "—")</b></div>
        <div class="kpi"><small>Income this year</small><b>@Fmt.Money(data.IncomeThisYear, currency)</b></div>
        <div class="kpi"><small>Cash</small><b>@Fmt.Money(data.Cash, currency)</b></div>
    </section>

    <div class="bento">
        <div class="wide" style="display: flex; flex-direction: column; gap: 16px">
            <section class="card" data-hviews>
                <div class="card-head">
                    <h2>Holdings</h2>
                    <div class="row" style="gap: 10px">
                        @if (hasPies)
                        {
                            <div class="seg mini" role="group" aria-label="Show holdings">
                                <button type="button" aria-pressed="true" data-hview="pies">Pies</button>
                                <button type="button" aria-pressed="false" data-hview="stocks">Stocks</button>
                            </div>
                        }
                        <a class="@(hasPies ? "desk-only" : null)" href="/holdings">@data.Positions.Count position@(data.Positions.Count == 1 ? string.Empty : "s") →</a>
                    </div>
                </div>
                @if (data.Positions.Count == 0)
                {
                    <p class="muted" style="margin-top: 10px">No open positions.</p>
                }
                else
                {
                    var topWeight = data.Positions[0].Weight;
                    if (hasPies)
                    {
                        var groupTop = groups.Count > 0 ? groups.Max(static group => group.Weight) : 0m;
                        <div data-hpane="pies">
                            <div class="table-box desk-only">
                                <table class="table pies">
                                    <thead>
                                        <tr><th scope="col">Asset</th><th scope="col" style="text-align: left">Weight</th><th scope="col">Value</th><th scope="col">Invested</th><th scope="col">Return</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var group in groups.Take(10))
                                        {
                                            if (group.Pie is { } pie)
                                            {
                                                var shown = pie.Holdings.Take(8).ToList();
                                                var rest = pie.Holdings.Skip(8).ToList();
                                                <tr class="pie-row" data-pie="@pie.Id" tabindex="0" aria-expanded="false">
                                                    <td><div class="who"><span class="caret" aria-hidden="true">›</span>@Ui.PieIcon(pie.Holdings.Select(static holding => holding.Value), "sm")<span><span class="ellipsis" style="display: block; max-width: 210px">@pie.Name</span><small class="muted" style="font-size: 11.5px; font-weight: 500">Pie · @pie.Holdings.Count holding@(pie.Holdings.Count == 1 ? string.Empty : "s")</small></span></div></td>
                                                    <td class="wcell"><div class="weight" style="margin: 0"><span class="bar"><i class="bg-pie" style="width: @Charts.N(groupTop > 0 ? (double)(pie.Weight / groupTop) * 100 : 0)%"></i></span><small>@Fmt.Pct(pie.Weight)</small></div></td>
                                                    <td class="strong">@Fmt.Money(pie.Value, currency)</td>
                                                    <td>@Fmt.Money(pie.Invested, currency)</td>
                                                    <td class="strong">@Ui.Return(pie.Gain, pie.GainPct, currency)</td>
                                                </tr>
                                                foreach (var holding in shown)
                                                {
                                                    <tr class="child link" data-pie-of="@pie.Id" data-href="@Ui.Href(holding.Instrument)" hidden>
                                                        <td><a class="who" href="@Ui.Href(holding.Instrument)"><span class="caret none"></span><span class="tree"></span>@Ui.Asset(holding.Instrument, logos, "sm")<span class="ellipsis" style="max-width: 190px">@holding.Instrument.Name</span></a></td>
                                                        <td class="wcell"><div class="weight" style="margin: 0"><span class="bar"><i class="bg-@Fmt.ClassCss(holding.Instrument.Class)" style="width: @Charts.N(groupTop > 0 ? (double)(holding.Weight / groupTop) * 100 : 0)%"></i></span><small>@Fmt.Pct(holding.Weight)</small></div></td>
                                                        <td>@Fmt.Money(holding.Value, currency)</td>
                                                        <td>@Fmt.Money(holding.Invested, currency)</td>
                                                        <td>@Ui.Return(holding.Gain, holding.GainPct, currency)</td>
                                                    </tr>
                                                }
                                                if (rest.Count > 0)
                                                {
                                                    var restValue = rest.Sum(static holding => holding.Value);
                                                    var restInvested = rest.Sum(static holding => holding.Invested);
                                                    <tr class="child" data-pie-of="@pie.Id" hidden>
                                                        <td><div class="who"><span class="caret none"></span><span class="tree"></span><span class="asset other sm" aria-hidden="true">+@rest.Count</span><span>@rest.Count more holding@(rest.Count == 1 ? string.Empty : "s")</span></div></td>
                                                        <td class="wcell"><div class="weight" style="margin: 0"><span class="bar"><i class="bg-other" style="width: @Charts.N(groupTop > 0 ? (double)(rest.Sum(static holding => holding.Weight) / groupTop) * 100 : 0)%"></i></span><small>@Fmt.Pct(rest.Sum(static holding => holding.Weight))</small></div></td>
                                                        <td>@Fmt.Money(restValue, currency)</td>
                                                        <td>@Fmt.Money(restInvested, currency)</td>
                                                        <td>@Ui.Return(restValue - restInvested, restInvested > 0 ? (restValue - restInvested) / restInvested : null, currency)</td>
                                                    </tr>
                                                }
                                            }
                                            else if (group.Slice is { } slice)
                                            {
                                                <tr class="link" data-href="@Ui.Href(slice.Instrument)">
                                                    <td><a class="who" href="@Ui.Href(slice.Instrument)"><span class="caret none"></span>@Ui.Asset(slice.Instrument, logos, "sm")<span><span class="ellipsis" style="display: block; max-width: 210px">@slice.Instrument.Name</span><small class="muted mono" style="font-size: 11px; font-weight: 500">@Fmt.Qty(slice.Quantity) @slice.Instrument.Symbol</small></span></a></td>
                                                    <td class="wcell"><div class="weight" style="margin: 0"><span class="bar"><i class="bg-@Fmt.ClassCss(slice.Instrument.Class)" style="width: @Charts.N(groupTop > 0 ? (double)(slice.Weight / groupTop) * 100 : 0)%"></i></span><small>@Fmt.Pct(slice.Weight)</small></div></td>
                                                    <td class="strong">@Fmt.Money(slice.Value, currency)</td>
                                                    <td>@Fmt.Money(slice.Invested, currency)</td>
                                                    <td class="strong">@Ui.Return(slice.Gain, slice.GainPct, currency)</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="list phone-only" style="margin-top: 4px">
                                @foreach (var group in groups.Take(8))
                                {
                                    if (group.Pie is { } pie)
                                    {
                                        <div class="item pie-row" role="button" tabindex="0" aria-expanded="false" data-pie="@pie.Id">
                                            @Ui.PieIcon(pie.Holdings.Select(static holding => holding.Value))
                                            <div class="grow">
                                                <div class="name">@pie.Name</div>
                                                <small class="meta">Pie · @pie.Holdings.Count holding@(pie.Holdings.Count == 1 ? string.Empty : "s") <span class="caret" aria-hidden="true">›</span></small>
                                            </div>
                                            <div class="end"><b>@Fmt.Money(pie.Value, currency)</b><small class="@Fmt.Trend(pie.Gain)">@Fmt.SignedMoney(pie.Gain, currency) (@Fmt.Pct(pie.GainPct is { } g ? Math.Abs(g) : null, 2))</small></div>
                                        </div>
                                        <div class="kids" data-pie-of="@pie.Id" hidden>
                                            @foreach (var holding in pie.Holdings.Take(12))
                                            {
                                                <a class="item child" href="@Ui.Href(holding.Instrument)">
                                                    <span class="tree"></span>
                                                    @Ui.Asset(holding.Instrument, logos, "sm")
                                                    <div class="grow"><div class="name">@holding.Instrument.Name</div><small class="meta mono">@Fmt.Qty(holding.Quantity) @holding.Instrument.Symbol</small></div>
                                                    <div class="end"><b>@Fmt.Money(holding.Value, currency)</b><small class="@Fmt.Trend(holding.Gain)">@Fmt.SignedMoney(holding.Gain, currency) (@Fmt.Pct(holding.GainPct is { } hg ? Math.Abs(hg) : null, 2))</small></div>
                                                </a>
                                            }
                                            @if (pie.Holdings.Count > 12)
                                            {
                                                <p class="hint" style="margin: 6px 0 4px 48px">and @(pie.Holdings.Count - 12) more in Holdings</p>
                                            }
                                        </div>
                                    }
                                    else if (group.Slice is { } slice)
                                    {
                                        <a class="item" href="@Ui.Href(slice.Instrument)">
                                            @Ui.Asset(slice.Instrument, logos)
                                            <div class="grow">
                                                <div class="name">@slice.Instrument.Name</div>
                                                <small class="meta mono">@Fmt.Qty(slice.Quantity) @slice.Instrument.Symbol</small>
                                            </div>
                                            <div class="end"><b>@Fmt.Money(slice.Value, currency)</b><small class="@Fmt.Trend(slice.Gain)">@Fmt.SignedMoney(slice.Gain, currency) (@Fmt.Pct(slice.GainPct is { } sg ? Math.Abs(sg) : null, 2))</small></div>
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    }
                    <div data-hpane="stocks" hidden="@(hasPies ? "hidden" : null)">
                        <div class="table-box desk-only">
                            <table class="table pies">
                                <thead>
                                    <tr><th scope="col">Asset</th><th scope="col" style="text-align: left">Weight</th><th scope="col">Value</th><th scope="col">Invested</th><th scope="col">Return</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var position in data.Positions.Take(8))
                                    {
                                        <tr class="link" data-href="@Ui.Href(position.Instrument)">
                                            <td><a class="who" href="@Ui.Href(position.Instrument)">@Ui.Asset(position.Instrument, logos, "sm")<span><span class="ellipsis" style="display: block; max-width: 210px">@position.Instrument.Name</span><small class="muted mono" style="font-size: 11px; font-weight: 500">@Fmt.Qty(position.Quantity) @position.Instrument.Symbol</small></span></a></td>
                                            <td class="wcell"><div class="weight" style="margin: 0"><span class="bar"><i class="bg-@Fmt.ClassCss(position.Instrument.Class)" style="width: @Charts.N(topWeight > 0 ? (double)(position.Weight / topWeight) * 100 : 0)%"></i></span><small>@Fmt.Pct(position.Weight)</small></div></td>
                                            <td class="strong">@Fmt.Money(position.Value, currency)</td>
                                            <td>@Fmt.Money(position.Cost, currency)</td>
                                            <td class="strong">@Ui.Return(position.Unrealized, position.UnrealizedPct, currency)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="list phone-only" style="margin-top: 4px">
                            @foreach (var position in data.Positions.Take(5))
                            {
                                <a class="item" href="@Ui.Href(position.Instrument)">
                                    @Ui.Asset(position.Instrument, logos)
                                    <div class="grow">
                                        <div class="name">@position.Instrument.Name</div>
                                        <div class="weight"><span class="bar"><i class="bg-@Fmt.ClassCss(position.Instrument.Class)" style="width: @Charts.N(topWeight > 0 ? (double)(position.Weight / topWeight) * 100 : 0)%"></i></span><small>@Fmt.Pct(position.Weight)</small></div>
                                    </div>
                                    <div class="end"><b>@Fmt.Money(position.Value, currency)</b><small class="@Fmt.Trend(position.Unrealized)">@Fmt.SignedMoney(position.Unrealized, currency) (@Fmt.Pct(position.UnrealizedPct is { } pu ? Math.Abs(pu) : null, 2))</small></div>
                                </a>
                            }
                        </div>
                    </div>
                    if (hasPies)
                    {
                        <a class="more phone-only" href="/holdings">All @data.Positions.Count position@(data.Positions.Count == 1 ? string.Empty : "s") →</a>
                    }
                }
            </section>

        </div>

        <div class="side">
            @if (data.Allocation.Count > 0)
            {
                // A ring split by asset class (and cash), the total in the middle.
                const double Circle = 2 * Math.PI * 52;
                var at = 0d;
                <section class="card">
                    <div class="card-head">
                        <h2>Allocation</h2>
                        <a href="/insights/exposure">Exposure →</a>
                    </div>
                    <div class="alloc">
                        <div class="donut-box">
                        <svg class="donut" viewBox="0 0 132 132" role="img" aria-label="@string.Join(", ", data.Allocation.Select(static slice => $"{slice.Label} {Fmt.Pct(slice.Percent)}"))">
                            <g transform="rotate(-90 66 66)">
                                @foreach (var slice in data.Allocation)
                                {
                                    var length = (double)slice.Percent * Circle;
                                    <circle class="s-@Fmt.ClassCss(slice.Key)" cx="66" cy="66" r="52" stroke-dasharray="@Charts.N(Math.Max(length - 2, 0.5)) @Charts.N(Circle)" stroke-dashoffset="@Charts.N(-at)" />
                                    at += length;
                                }
                            </g>
                            <circle class="inner" cx="66" cy="66" r="31" />
                        </svg>
                        <b class="center">@Fmt.Compact(data.TotalValue, currency)</b>
                        </div>
                        <div class="alloc-list">
                            @foreach (var slice in data.Allocation)
                            {
                                <div class="row"><span class="bg-@Fmt.ClassCss(slice.Key)"></span><span class="grow" style="color: var(--text-2)">@slice.Label</span><span class="muted desk-only">@Fmt.Money(slice.Value, currency, 0)</span><b style="width: 54px; text-align: right">@Fmt.Pct(slice.Percent)</b></div>
                            }
                        </div>
                    </div>
                </section>
            }

            <section class="card dividends">
                <div class="card-head">
                    <h2>Next dividends</h2>
                    <a href="/income">Calendar →</a>
                </div>
                @if (data.Upcoming.Count > 0)
                {
                    <div class="next-list">
                        @foreach (var payment in data.Upcoming.Take(3))
                        {
                            var (month, day) = Fmt.Tile(payment.Day);
                            <a class="next" href="@Ui.Href(payment.Instrument)">
                                <span class="when"><small>@month</small><b>@day</b></span>
                                <span class="grow"><b class="ellipsis">@payment.Instrument.Name</b><small>@payment.Instrument.Symbol · expected, from last year's</small></span>
                                <b class="amt">+@Fmt.Money(payment.Amount, currency)</b>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="muted" style="margin-top: 12px; font-size: 13px">No dividends expected in the next months.</p>
                }
                <div class="income-line">
                    <div class="row" style="justify-content: space-between; font-size: 12.5px"><span class="muted">@Fmt.Money(data.IncomeThisYear, currency) received in @Clock.Today.Year@(incomeYear is { } y ? " of ≈ " + Fmt.Money(y, currency, 0) : string.Empty)</span><b>@Fmt.Pct(data.IncomeProgress, 0)</b></div>
                    <div class="bar"><i style="width: @Charts.N((double)(data.IncomeProgress ?? 0) * 100)%"></i></div>
                    <small class="muted">≈ @Fmt.Money(data.IncomeNext12, currency, 0) over the next 12 months</small>
                </div>
            </section>

            <a class="card flat row phone-only" href="/activity" style="color: var(--text)">
                <span class="ico-chip" style="display: grid; place-items: center; width: 40px; height: 40px; border-radius: 13px; background: var(--lime-soft); color: var(--lime)">@Icons.Get("activity")</span>
                <span class="grow"><b style="display: block">Activity</b><small class="muted">Every buy, sell, dividend and deposit</small></span>
                @Icons.Get("right")
            </a>
        </div>
    </div>
}
