<script>
    (function () {
        document.querySelectorAll(".password-toggle").forEach(function (toggle) {
            var input = document.getElementById(toggle.getAttribute("data-for"));
            toggle.addEventListener("click", function () {
                var show = input.type === "password";
                input.type = show ? "text" : "password";
                toggle.setAttribute("aria-pressed", show ? "true" : "false");
                toggle.setAttribute("aria-label", show ? "Hide password" : "Show password");
                input.focus();
            });
        });
        var demo = document.querySelector("[data-demo-fill]");
        if (demo) demo.addEventListener("click", function () {
            document.querySelector("input[name=userName]").value = demo.getAttribute("data-user");
            document.querySelector("input[name=password]").value = demo.getAttribute("data-pass");
            demo.closest("form").requestSubmit();
        });
    })();
</script>
