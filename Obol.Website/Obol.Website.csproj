<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Obol, the app (MVC): the landing page, sign-in and the screens, for the phone and the computer. Talks to
       Obol.WebApi only through Obol.Sdk. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>obol-website-6b0e93d1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Obol.Sdk\Obol.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Obol.UnitTest" />
  </ItemGroup>

</Project>
