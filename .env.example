# Copy this file to ".env" (next to docker-compose.yml) and fill it in.
# .env holds secrets: don't share it or put it in git.
# No spaces around "=". If a value has # or spaces, wrap it in single quotes: 'a#b c'.

# ---------- Required ----------

# SQL Server's sa password: at least 8 characters with three of upper case, lower case, digits and symbols
# (avoid ; and quotes).
SQL_SA_PASSWORD=Change-Me-2026!

# Internal key between the website and the WebApi. Make up a long random string
# (e.g. in PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_}) ).
OBOL_API_KEY=change-this-to-a-long-random-key

# Encrypts your Trading 212 API key and secret in the database (at least 16 characters; another long random string).
# Keep it: if it changes, Obol can't read the saved key and you connect Trading 212 again.
OBOL_ENCRYPTION_KEY=change-this-to-another-long-random-key

# Asked for only when creating the FIRST account (the admin), so nobody else on the network can create it before you.
OBOL_SETUP_KEY=change-this

# ---------- Optional ----------

# Company and fund logos: a free publishable key from https://logo.dev (starts with pk_). Empty = ticker badges.
# OBOL_LOGO_TOKEN=pk_...

# Daily closing prices from Yahoo Finance for the charts. false = Obol only uses the prices Trading 212 and your trades
# give (the charts get coarser).
# OBOL_PRICE_HISTORY=true

# The currency of your Trading 212 account (taken from Trading 212 once connected; this is for CSV-only accounts).
# OBOL_CURRENCY=EUR

# Minutes between automatic syncs (0 = only when you tap Sync now).
# OBOL_SYNC_MINUTES=30

# false = after the first account, nobody can create one from the sign-in page.
# OBOL_ALLOW_REGISTRATION=true

# Days start at midnight in this time zone.
# TIME_ZONE=Europe/Lisbon

# OBOL_PORT=5095
# SQL_PORT=1436
# SQL_MEMORY_LIMIT_MB=1024
# SQL_CPUS=2
# OBOL_CPUS=1
# OBOL_WEBAPI_MEMORY=512m
# OBOL_WEBSITE_MEMORY=384m

# true = a sample portfolio in memory, no SQL Server or Trading 212 needed (sign in as demo / obol-demo).
# OBOL_DEMO_MODE=false
